# National Unified Material Master Platform - ML Service Configuration
# Copy this file to .env and adjust values as needed.

# Host and Port Configuration
ML_HOST=0.0.0.0
ML_PORT=8001

# Model and Embedding Configuration
# Path to local model directory or HuggingFace model identifier
EMBEDDING_MODEL_PATH=models/all-MiniLM-L6-v2
# Set to 1 to prevent any online calls to HuggingFace Hub
HF_HUB_OFFLINE=1

# LLM Adjudication Service (Ollama)
OLLAMA_URL=http://127.0.0.1:11434
LLM_MODEL=qwen2.5:3b

# Deduplication and Matching Parameters
# Threshold for clustering pairwise similarity (0.0 to 1.0)
MATCH_THRESHOLD=0.82

# Economic & Savings Projections
# Default volume consolidation procurement savings percentage (e.g., 0.08 for 8%)
SAVINGS_PERCENTAGE=0.08

# Storage & Output Paths
PROCESSED_DATA_DIR=data/processed
